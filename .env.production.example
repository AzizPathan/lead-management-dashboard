# Use your Railway Mongo plugin URL or MongoDB Atlas URL.
# The backend also accepts MONGO_URL or DATABASE_URL when Railway provides those.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/smart-leads
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=https://your-vercel-app.vercel.app
VITE_API_URL=https://your-railway-api.up.railway.app/api
